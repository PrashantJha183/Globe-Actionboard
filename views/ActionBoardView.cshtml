@model RSuite.UserInterface.Web.Mvc.Models.Common.ActionBoard.ActionBoardViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="base-url" content="@Url.Content("~/")" />
    <title>@(Model.Name ?? "Dashboard")</title>
    @Scripts.Render("~/bundles/jquery")
    <script src="~/_ActionBoard/scripts/action-board-core.js"></script>
    <script src="~/_ActionBoard/scripts/action-board-theme.js"></script>
    <script src="~/_ActionBoard/scripts/action-board-report.js"></script>
    <script src="~/_ActionBoard/scripts/action-board-cards.js"></script>
    <script src="~/_ActionBoard/scripts/action-board-grid.js"></script>
    <link href="~/Content/JQueryUi.css" rel="stylesheet" type="text/css" />
    <link href="~/Scripts/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/_ActionBoard/styles/action-board-common.css" rel="stylesheet" />
    <link href="~/_ActionBoard/styles/action-board-cards.css" rel="stylesheet" />
    <link href="~/_ActionBoard/styles/action-board-report.css" rel="stylesheet" />
    <link href="~/_ActionBoard/styles/action-board-table.css" rel="stylesheet" />
</head>
<body>  
    @try
    {
        <div class="tt-header">
            <div class="tt-header-left">
                <div class="tt-header-title">@(Model.Name ?? "Dashboard")</div>
                <div class="tt-header-subtitle">@(Model.Description ?? "")</div>
            </div>
            <div class="tt-header-right">
                <i class="fa fa-moon-o tt-theme-icon" id="themeToggle"></i>
            </div>
        </div>
        <div class="tt-tabs" id="tabContainer">
            @if (Model.NavigationTabs != null)
            {
                foreach (var tab in Model.NavigationTabs)
                {
                    var isActive = false;
                    try { isActive = tab.IsDefault; } catch { }
                    <div class="tt-tab @(isActive ? "tt-active" : "")" data-group-id="@tab.Id">@(tab.Name ?? "")</div>
                }
            }
        </div>
        <div class="tt-card-grid-wrapper">
            <div class="tt-card-grid" id="cardGrid">
                <div class="tt-skeleton-card"><div class="tt-skeleton-icon"></div><div class="tt-skeleton-title"></div><div class="tt-skeleton-label"></div><div class="tt-skeleton-count"></div><div class="tt-skeleton-arrow"></div></div>
                <div class="tt-skeleton-card"><div class="tt-skeleton-icon"></div><div class="tt-skeleton-title"></div><div class="tt-skeleton-label"></div><div class="tt-skeleton-count"></div><div class="tt-skeleton-arrow"></div></div>
                <div class="tt-skeleton-card"><div class="tt-skeleton-icon"></div><div class="tt-skeleton-title"></div><div class="tt-skeleton-label"></div><div class="tt-skeleton-count"></div><div class="tt-skeleton-arrow"></div></div>
                <div class="tt-skeleton-card"><div class="tt-skeleton-icon"></div><div class="tt-skeleton-title"></div><div class="tt-skeleton-label"></div><div class="tt-skeleton-count"></div><div class="tt-skeleton-arrow"></div></div>
                <div class="tt-skeleton-card"><div class="tt-skeleton-icon"></div><div class="tt-skeleton-title"></div><div class="tt-skeleton-label"></div><div class="tt-skeleton-count"></div><div class="tt-skeleton-arrow"></div></div>
                <div class="tt-skeleton-card"><div class="tt-skeleton-icon"></div><div class="tt-skeleton-title"></div><div class="tt-skeleton-label"></div><div class="tt-skeleton-count"></div><div class="tt-skeleton-arrow"></div></div>
            </div>
        </div>
        <div id="reportPanel" class="tt-report-panel" style="display:none;">
            <div class="tt-report-header">
                <button class="tt-report-back-btn" onclick="ActionBoard.closeReportPanel()">
                    <i class="fa fa-arrow-left"></i> Back
                </button>
                <span id="reportTitle" class="tt-report-title"></span>
                <div id="reportIcon" class="tt-report-icon"></div>
            </div>
            <div class="tt-report-table-wrap">
            <iframe id="panelReportFrame" style="width:100%; height:calc(78vh - 170px); border:none;"></iframe>
            <div id="reportTableSkeleton" class="tt-table-skeleton" style="display:none;">
                <div class="tt-shimmer-table">
                    <div class="tt-shimmer-table-row tt-shimmer-table-header">
                        <div class="tt-shimmer-td" style="width:8%"></div>
                        <div class="tt-shimmer-td" style="width:22%"></div>
                        <div class="tt-shimmer-td" style="width:15%"></div>
                        <div class="tt-shimmer-td" style="width:12%"></div>
                        <div class="tt-shimmer-td" style="width:18%"></div>
                        <div class="tt-shimmer-td" style="width:10%"></div>
                        <div class="tt-shimmer-td" style="width:15%"></div>
                    </div>
                    <div class="tt-shimmer-table-row">
                        <div class="tt-shimmer-td" style="width:7%"></div>
                        <div class="tt-shimmer-td" style="width:20%"></div>
                        <div class="tt-shimmer-td" style="width:14%"></div>
                        <div class="tt-shimmer-td" style="width:10%"></div>
                        <div class="tt-shimmer-td" style="width:16%"></div>
                        <div class="tt-shimmer-td" style="width:9%"></div>
                        <div class="tt-shimmer-td" style="width:14%"></div>
                    </div>
                    <div class="tt-shimmer-table-row">
                        <div class="tt-shimmer-td" style="width:6%"></div>
                        <div class="tt-shimmer-td" style="width:18%"></div>
                        <div class="tt-shimmer-td" style="width:16%"></div>
                        <div class="tt-shimmer-td" style="width:11%"></div>
                        <div class="tt-shimmer-td" style="width:14%"></div>
                        <div class="tt-shimmer-td" style="width:8%"></div>
                        <div class="tt-shimmer-td" style="width:17%"></div>
                    </div>
                    <div class="tt-shimmer-table-row">
                        <div class="tt-shimmer-td" style="width:9%"></div>
                        <div class="tt-shimmer-td" style="width:21%"></div>
                        <div class="tt-shimmer-td" style="width:13%"></div>
                        <div class="tt-shimmer-td" style="width:10%"></div>
                        <div class="tt-shimmer-td" style="width:15%"></div>
                        <div class="tt-shimmer-td" style="width:11%"></div>
                        <div class="tt-shimmer-td" style="width:16%"></div>
                    </div>
                    <div class="tt-shimmer-table-row">
                        <div class="tt-shimmer-td" style="width:7%"></div>
                        <div class="tt-shimmer-td" style="width:19%"></div>
                        <div class="tt-shimmer-td" style="width:15%"></div>
                        <div class="tt-shimmer-td" style="width:12%"></div>
                        <div class="tt-shimmer-td" style="width:17%"></div>
                        <div class="tt-shimmer-td" style="width:9%"></div>
                        <div class="tt-shimmer-td" style="width:16%"></div>
                    </div>
                    <div class="tt-shimmer-table-row">
                        <div class="tt-shimmer-td" style="width:8%"></div>
                        <div class="tt-shimmer-td" style="width:21%"></div>
                        <div class="tt-shimmer-td" style="width:13%"></div>
                        <div class="tt-shimmer-td" style="width:11%"></div>
                        <div class="tt-shimmer-td" style="width:16%"></div>
                        <div class="tt-shimmer-td" style="width:10%"></div>
                        <div class="tt-shimmer-td" style="width:17%"></div>
                    </div>
                    <div class="tt-shimmer-table-row">
                        <div class="tt-shimmer-td" style="width:6%"></div>
                        <div class="tt-shimmer-td" style="width:20%"></div>
                        <div class="tt-shimmer-td" style="width:14%"></div>
                        <div class="tt-shimmer-td" style="width:12%"></div>
                        <div class="tt-shimmer-td" style="width:18%"></div>
                        <div class="tt-shimmer-td" style="width:9%"></div>
                        <div class="tt-shimmer-td" style="width:15%"></div>
                    </div>
                    <div class="tt-shimmer-table-row">
                        <div class="tt-shimmer-td" style="width:7%"></div>
                        <div class="tt-shimmer-td" style="width:18%"></div>
                        <div class="tt-shimmer-td" style="width:15%"></div>
                        <div class="tt-shimmer-td" style="width:10%"></div>
                        <div class="tt-shimmer-td" style="width:15%"></div>
                        <div class="tt-shimmer-td" style="width:11%"></div>
                        <div class="tt-shimmer-td" style="width:14%"></div>
                    </div>
                </div>
            </div>
            </div>
            <div id="ttPagination" class="tt-report-pagination"></div>
        </div>
    }
    catch (Exception ex)
    {
            <div class="tt-card-grid-wrapper">
            <div class="tt-card-grid" style="grid-column:1/-1;text-align:center;padding:60px 20px;">
                <div style="font-size:48px;color:var(--text-secondary);opacity:0.5;margin-bottom:12px;">
                    <i class="fa fa-exclamation-triangle"></i>
                </div>
                <div style="font-size:20px;font-weight:600;color:var(--text-primary);margin-bottom:8px;">
                    Dashboard Unavailable
                </div>
                <div style="font-size:14px;color:var(--text-secondary);">
                    Unable to load the dashboard. Please try refreshing the page.
                </div>
            </div>
        </div>
    }
    <div id="ttToastContainer"></div>
    <script>
        $(function () {
            ActionBoard.applySavedTheme();
            if (document.getElementById('themeToggle')) ActionBoard.bindThemeToggle();
            if (document.getElementById('cardGrid')) ActionBoard.init();
        });
    </script>
</body>
</html>
