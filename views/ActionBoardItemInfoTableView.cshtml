@model System.Data.DataSet
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="addurl-endpoint" content="@Url.Action("GetAddUrlByLinkId", "ActionBoard")" />
    @Scripts.Render("~/bundles/jquery")
    <script src="~/_ActionBoard/scripts/action-board-core.js"></script>
    <script src="~/_ActionBoard/scripts/xlsx.mini.min.js"></script>
    <script src="~/_ActionBoard/scripts/action-board-grid.js"></script>
    <link href="~/Scripts/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/_ActionBoard/styles/action-board-common.css" rel="stylesheet" />
    <link href="~/_ActionBoard/styles/action-board-table.css" rel="stylesheet" />
</head>
<body>
    @{
        int tblIdx = 0;
        foreach (System.Data.DataTable dt in Model.Tables)
        {
            if (dt.Rows.Count == 0) { continue; }
            tblIdx++;
            if (tblIdx == 1)
            {
                <div class="tt-grid-toolbar">
                    <div class="tt-grid-search-wrap">
                        <i class="fa fa-search tt-grid-search-icon"></i>
                        <input type="text" id="ttGridSearch" class="tt-grid-search" placeholder="Search all columns..." autocomplete="off" />
                        <i class="fa fa-times tt-grid-search-clear" id="ttGridSearchClear" title="Clear search"></i>
                    </div>
                    <span id="ttGridSearchCount" class="tt-grid-search-count"></span>
                    <button type="button" id="ttGridExport" class="tt-grid-export-btn" data-export-name="@ViewBag.CardTitle">
                        <i class="fa fa-file-excel-o"></i><span>Export to Excel</span>
                    </button>
                </div>
            }
        <div class="tt-grid-table-wrap">
                <table class="tt-grid-table" data-tbl-idx="@tblIdx">
                    <thead>
                        <tr>
                            @foreach (System.Data.DataColumn c in dt.Columns)
                            {
                                <th>@c.ColumnName</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (System.Data.DataRow r in dt.Rows)
                        {
                            <tr>
                                @foreach (System.Data.DataColumn c in dt.Columns)
                                {
                                    <td>@Html.Raw(r[c.ColumnName])</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        if (tblIdx == 0)
        {
            <div class="tt-empty-state">
                <i class="fa fa-inbox"></i>
                <div>No data available.</div>
            </div>
        }
    }
    <script>
        $(function () {
            var gridMeta = document.querySelector('meta[name="addurl-endpoint"]');
            if (gridMeta) window._addUrlByLinkIdEndpoint = gridMeta.getAttribute('content');
            if (document.querySelector('.tt-grid-table')) {
                ActionBoard.initGridPagination();
                ActionBoard.initGridSearch();
                ActionBoard.initGridExport();
                ActionBoard.enhanceGridActionButtons();
            }
        });
    </script>
</body>
</html>
